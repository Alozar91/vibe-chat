<?xml version="1.0" encoding="utf-8"?>
<!--
  Release: https обязателен (стенд merch-vibe.ru — KC/Silo/API/LiveKit по TLS).
  Cleartext разрешён ТОЛЬКО dev-адресам: localhost (adb reverse), 10.0.2.2
  (эмулятор -> хост), 192.168.1.64 (LAN-IP хоста с dev-LiveKit, машинно-специфичен).
  debug-оверлей (usesCleartextTraffic=true) перекрывается NSC — правила те же.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">192.168.1.64</domain>
    </domain-config>
</network-security-config>
