# Vibe Chat mobile — окружение.
# Самодостаточность сборки убрана (Docs/concept.md §19.3): адрес сервера вводится
# на первом экране, остальное клиент получает из GET /server/info.
# Остались только dev-override'ы, которые сервер рассказать не может.

# LiveKit WS для звонков: переопределяет ws_url из room-токена ТОЛЬКО в dev
# (из эмулятора localhost не резолвится — нужен 10.0.2.2). В release не задаётся.
EXPO_PUBLIC_LIVEKIT_URL=ws://10.0.2.2:7880

# Кодовое слово сервера можно ввести прямо на экране подключения (опционально).
