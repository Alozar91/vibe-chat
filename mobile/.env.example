# Env-профили мобильного клиента (Docs/android.md §3.7).
# Всё через EXPO_PUBLIC_* — значения запекаются при сборке (как VITE_* у веба).

# --- dev: эмулятор, локальный бэкенд ---
# 10.0.2.2 — loopback хоста из эмулятора Android
EXPO_PUBLIC_API_BASE=http://10.0.2.2:8002/api/v1
EXPO_PUBLIC_WS_BASE=ws://10.0.2.2:8002/api/v1/ws
EXPO_PUBLIC_SILO_PUBLIC_URL=http://10.0.2.2:9000
# KC — именно localhost:8080 (+ adb reverse tcp:8080, см. mobile/README.md):
# iss токенов = KC_HOSTNAME/frontendUrl = http://localhost:8080 — по нему
# валидирует бэкенд; весь PKCE-флоу должен ходить на одном хосте
EXPO_PUBLIC_KC_URL=http://localhost:8080
EXPO_PUBLIC_KC_REALM=vibe-chat
EXPO_PUBLIC_KC_CLIENT_ID=mobile

# --- стенд merch-vibe.ru (для сборки против прода) ---
# EXPO_PUBLIC_API_BASE=https://merch-vibe.ru/chat/api/v1
# EXPO_PUBLIC_WS_BASE=wss://merch-vibe.ru/chat/api/v1/ws
# EXPO_PUBLIC_SILO_PUBLIC_URL=https://merch-vibe.ru
# EXPO_PUBLIC_KC_URL=https://merch-vibe.ru:8444
# EXPO_PUBLIC_KC_REALM=vibe-chat
# EXPO_PUBLIC_KC_CLIENT_ID=mobile

# --- звонки (§3.12): LiveKit override; в dev — ws://10.0.2.2:7880, на стенде не задан ---
# EXPO_PUBLIC_LIVEKIT_URL=ws://10.0.2.2:7880

# --- гейт версии (§3.8): прямая ссылка на раздачу APK; не задана — «обратитесь к администратору" ---
# EXPO_PUBLIC_APP_DOWNLOAD_URL=https://merch-vibe.ru/chat/app.apk
