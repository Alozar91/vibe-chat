# Vibe Chat — тестовый стенд сервера (docker-compose.server.yml + системный nginx).
# Схема «системный nginx хоста»: /know → vibe-know (позже), /chat → vibe-chat (сейчас).
# Порты vibe-chat публикуются только на 127.0.0.1; наружу — системный nginx (443) и LiveKit.
# Скопируйте в deploy/server.env и заполните. Файл НЕ коммитится (секреты).
#
# Порядок первого запуска (vibe-chat):
#   1. cd frontend && npm ci
#      VITE_BASE_PATH="/chat/" VITE_KC_URL="https://<домен>:8444" npm run build
#      (VITE_KC_URL обязателен: адрес Keycloak запекается в SPA при сборке;
#       dist монтируется во frontend-контейнер)
#   2. cp deploy/server.env.example deploy/server.env → заполнить
#   3. docker compose -f deploy/docker-compose.server.yml --env-file deploy/server.env up -d --build
#   4. Миграции + seed платформенного админа и первого инвайта (см. блок «Порты» ниже):
#      docker compose -f deploy/docker-compose.server.yml exec backend alembic upgrade head
#      docker compose -f deploy/docker-compose.server.yml exec backend python -m app.scripts.seed_admin
#   5. Полный пример конфига системного nginx — deploy/nginx-location-snippet.conf
#      (секции /chat и /silo; секции /know — включить при деплое vibe-know):
#      nginx -t && nginx -s reload
#   6. Открыть в файрволе: 7881/tcp + 50000-60000/udp (LiveKit-медиа — мимо nginx).
#
# Порты vibe-chat на хосте (все 127.0.0.1, кроме LiveKit):
#   8090 — frontend-nginx (системный nginx → /chat/)
#   8002 — backend (debug; 8001 оставлен vibe-know api; роутинг API — через frontend-контейнер)
#   8081 — Keycloak (системный nginx → server-блок 8444 ssl)
#   9002 — Silo S3 API (системный nginx → /silo/, presigned)
#   9003 — Silo-консоль (только с localhost)
#   7881 + 50000-60000/udp — LiveKit напрямую (наружу)
# Порты vibe-know на хосте (при его деплое): 8082 nginx, 8001 api, 8080 KC,
#   5432 postgres, 6379 valkey, 9090/9093/9100/9187 мониторинг — конфликтов нет.
#
# После первого запуска — seed платформенного админа и первого инвайта (§5):
#   docker compose -f deploy/docker-compose.server.yml exec backend alembic upgrade head
#   docker compose -f deploy/docker-compose.server.yml exec backend python -m app.scripts.seed_admin
#   (пароль админа берётся из KC_ADMIN_PASSWORD; создастся админ 'admin'
#    и multi-use инвайт — код напечатается один раз, сохраните его)
# Повторный запуск безвреден (идемпотентно).

# Домен, на который выдан LE-сертификат системного nginx (A-запись → сервер)
VIBE_DOMAIN=chat.example.com

# Пароли (смените)
POSTGRES_PASSWORD=change-me-postgres
SILO_ROOT_USER=vibe
SILO_ROOT_PASSWORD=change-me-silo
KC_ADMIN=admin
KC_ADMIN_PASSWORD=change-me-kc-admin
# Секрет клиента backend-admin (Admin API для инвайт-регистрации; §5)
KC_BACKEND_ADMIN_SECRET=change-me-backend-admin-secret

# LiveKit (сгенерируйте: openssl rand -hex 32)
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret
