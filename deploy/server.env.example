# Vibe Chat — тестовый стенд сервера (docker-compose.server.yml).
# Скопируйте в deploy/server.env и заполните. Файл НЕ коммитится (секреты).
#
# Порядок первого запуска:
#   1. npm ci && npm run build          (frontend/ — собранный dist монтируется в edge)
#   2. cp deploy/server.env.example deploy/server.env  → заполнить
#   3. docker compose -f deploy/docker-compose.server.yml --env-file deploy/server.env up -d --build
#   4. Один раз: миграции + seed админа:
#      docker compose -f deploy/docker-compose.server.yml exec backend alembic upgrade head
#   5. Открыть https://<домен>:8443 (порт 8443/tcp, 8444/tcp, 7881/tcp,
#      50000-60000/udp должны быть открыты в файрволе)

# Домен, на который выдан LE-сертификат (A-запись → сервер)
VIBE_DOMAIN=chat.example.com

# Каталог /etc/letsencrypt (монтируется read-only в edge-nginx целиком —
# симлинки live/ → archive/ должны резолвиться). Для certbot: /etc/letsencrypt
LE_CERT_DIR=/etc/letsencrypt

# Пароли (смените)
POSTGRES_PASSWORD=change-me-postgres
SILO_ROOT_USER=vibe
SILO_ROOT_PASSWORD=change-me-silo
KC_ADMIN=admin
KC_ADMIN_PASSWORD=change-me-kc-admin
# Секрет клиента backend-admin (Admin API для инвайт-регистрации; §5)
KC_BACKEND_ADMIN_SECRET=change-me-backend-admin-secret

# LiveKit (сгенерируйте: openssl rand -hex 32)
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret
