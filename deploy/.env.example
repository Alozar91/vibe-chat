# ── PostgreSQL ────────────────────────────────────────────────
POSTGRES_USER=vibe
POSTGRES_PASSWORD=vibe
POSTGRES_DB=vibe

# ── Silo (S3-совместимое хранилище; MINIO_* — легаси env самого Silo) ──
SILO_ROOT_USER=vibe
SILO_ROOT_PASSWORD=vibe-secret
# CORS: SPA-origin → Silo-origin cross-origin PUT (§8). В prod — домены через запятую.
SILO_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Keycloak ─────────────────────────────────────────────────
KC_ADMIN=admin
KC_ADMIN_PASSWORD=admin
