{
  "realm": "messenger",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "resetPasswordAllowed": true,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "maxFailureWaitSeconds": 900,
  "minimumQuickLoginWaitSeconds": 60,
  "passwordPolicy": "length(12) and digits(1) and upperCase(1) and lowerCase(1) and specialChars(1) and notUsername",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 43200,
  "ssoSessionMaxLifespan": 604800,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "defaultDefaultClientScopes": ["api-audience", "basic", "profile", "email"],
  "clientScopes": [
    {
      "name": "api-audience",
      "description": "Audience messenger-api для access-токенов",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "false", "display.on.consent.screen": "false" },
      "protocolMappers": [
        {
          "name": "aud-messenger-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": { "included.custom.audience": "messenger-api", "access.token.claim": "true", "id.token.claim": "false" }
        }
      ]
    },
    {
      "name": "basic",
      "description": "OpenID Connect scope для sub, auth_time",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "false", "display.on.consent.screen": "false" },
      "protocolMappers": [
        {
          "name": "sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "consentRequired": false,
          "config": { "id.token.claim": "true", "access.token.claim": "true", "userinfo.token.claim": "true" }
        },
        {
          "name": "auth_time",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usersessionmodel-note-mapper",
          "consentRequired": false,
          "config": { "user.session.note": "AUTH_TIME", "id.token.claim": "true", "access.token.claim": "true", "claim.name": "auth_time", "jsonType.label": "long", "userinfo.token.claim": "true" }
        }
      ]
    },
    {
      "name": "profile",
      "description": "OpenID Connect built-in scope: profile",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "true", "consent.screen.text": "${profileScopeConsentText}" },
      "protocolMappers": [
        { "name": "username", "protocol": "openid-connect", "protocolMapper": "oidc-usermodel-attribute-mapper", "consentRequired": false, "config": { "user.attribute": "username", "id.token.claim": "true", "access.token.claim": "true", "claim.name": "preferred_username", "jsonType.label": "String", "userinfo.token.claim": "true" } },
        { "name": "full name", "protocol": "openid-connect", "protocolMapper": "oidc-full-name-mapper", "consentRequired": false, "config": { "id.token.claim": "true", "access.token.claim": "false", "userinfo.token.claim": "true" } },
        { "name": "given name", "protocol": "openid-connect", "protocolMapper": "oidc-usermodel-attribute-mapper", "consentRequired": false, "config": { "user.attribute": "firstName", "id.token.claim": "true", "access.token.claim": "false", "claim.name": "given_name", "jsonType.label": "String", "userinfo.token.claim": "true" } },
        { "name": "family name", "protocol": "openid-connect", "protocolMapper": "oidc-usermodel-attribute-mapper", "consentRequired": false, "config": { "user.attribute": "lastName", "id.token.claim": "true", "access.token.claim": "false", "claim.name": "family_name", "jsonType.label": "String", "userinfo.token.claim": "true" } }
      ]
    },
    {
      "name": "email",
      "description": "OpenID Connect built-in scope: email",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "true", "consent.screen.text": "${emailScopeConsentText}" },
      "protocolMappers": [
        { "name": "email", "protocol": "openid-connect", "protocolMapper": "oidc-usermodel-attribute-mapper", "consentRequired": false, "config": { "user.attribute": "email", "id.token.claim": "true", "access.token.claim": "false", "claim.name": "email", "jsonType.label": "String", "userinfo.token.claim": "true" } },
        { "name": "email verified", "protocol": "openid-connect", "protocolMapper": "oidc-usermodel-property-mapper", "consentRequired": false, "config": { "user.attribute": "emailVerified", "id.token.claim": "true", "access.token.claim": "false", "claim.name": "email_verified", "jsonType.label": "boolean", "userinfo.token.claim": "true" } }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "messenger-web",
      "name": "Vibe.Chat Web (BFF)",
      "enabled": true,
      "protocol": "openid-connect",
  "publicClient": false,
  "secret": "${MESSENGER_WEB_CLIENT_SECRET}",
  "standardFlowEnabled": true,
  "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:8080/v1/auth/callback",
        "http://localhost:3000/v1/auth/callback"
      ],
      "webOrigins": ["http://localhost:8080", "http://localhost:3000"],
      "attributes": { "post.logout.redirect.uris": "+" },
      "defaultClientScopes": ["api-audience", "basic", "profile", "email"],
      "optionalClientScopes": []
    },
    {
      "clientId": "messenger-mobile",
      "name": "Vibe.Chat Mobile (Flutter)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "com.vibe.chat:/oauth2redirect",
        "http://localhost:*/oauth2redirect"
      ],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "defaultClientScopes": ["api-audience", "basic", "profile", "email"],
      "optionalClientScopes": []
    },
    {
      "clientId": "messenger-api",
      "name": "Vibe.Chat API (audience)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "defaultClientScopes": []
    },
    {
      "clientId": "messenger-backend",
      "name": "Vibe.Chat Backend (service account)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${MESSENGER_BACKEND_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "defaultClientScopes": []
    }
  ]
}
