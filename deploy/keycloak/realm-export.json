{
  "realm": "vibe-chat",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "users": [
    {
      "username": "admin",
      "enabled": true,
      "email": "admin@vibe.local",
      "emailVerified": true,
      "firstName": "Платформенный",
      "lastName": "Админ",
      "credentials": [
        { "type": "password", "value": "admin", "temporary": false }
      ],
      "attributes": {
        "is_platform_admin": ["true"]
        , "timezone": ["Europe/Moscow"]
      }
    }
  ],
  "clients": [
    {
      "clientId": "frontend",
      "name": "Vibe Chat SPA",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:5173/*",
        "http://localhost:3000/*"
      ],
      "webOrigins": [
        "http://localhost:5173",
        "http://localhost:3000"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "defaultClientScopes": [
        "profile",
        "email",
        "backend-api"
      ],
      "optionalClientScopes": []
    },
    {
      "clientId": "backend-api",
      "name": "Vibe Chat Backend (audience)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": true,
      "secret": "backend-api-secret-not-used"
    }
  ],
  "clientScopes": [
    {
      "name": "backend-api",
      "description": "audience backend-api (обязателен, §13)",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true"
      },
      "protocolMappers": [
        {
          "name": "audience backend-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapping",
          "consentRequired": false,
          "config": {
            "included.client.audience": "backend-api"
          }
        }
      ]
    }
  ]
}
