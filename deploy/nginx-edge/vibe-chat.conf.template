# vibe-chat — edge-nginx тестового стенда (Docs/concept.md §13).
# Схема «свой nginx на своих портах»: соседний проект со своим nginx не затрагивается.
#   8443 — SPA + REST/WS + Silo (presigned) + LiveKit-сигналинг
#   8444 — Keycloak (iss = https://<домен>:8444/realms/vibe-chat)
# Сертификат домена (LE) монтируется read-only: он валиден на любом порту.

server {
    listen 8443 ssl;
    http2 on;
    server_name _;

    ssl_certificate     ${LE_CERT_PATH}/fullchain.pem;
    ssl_certificate_key ${LE_CERT_PATH}/privkey.pem;

    # файлы до 100 МБ (§16) идут presigned PUT через edge на /vibe-files/
    client_max_body_size 110m;

    # SPA (этап 10)
    root /usr/share/nginx/html;
    index index.html;
    location / {
        try_files $uri $uri/ /index.html;
    }

    # REST → backend (§13)
    location /api/v1/ {
        proxy_pass http://backend:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    # WS → backend (§9): одноразовые ticket'и, долгоживущее соединение
    location /api/v1/ws {
        proxy_pass http://backend:8000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 3600s;
    }

    # LiveKit-сигналинг (§17): wss://домен:8443/livekit/rtc → livekit:7880/rtc
    # (слэш в proxy_pass вырезает префикс /livekit)
    location /livekit/ {
        proxy_pass http://livekit:7880/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # Silo presigned PUT/GET (§8): путь /vibe-files/... сохраняется как есть,
    # Host — исходный (входит в подпись; APP_SILO_PUBLIC_URL=https://домен:8443).
    # Same-origin — CORS для загрузок не нужен.
    location /vibe-files/ {
        proxy_pass http://silo:9000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
    }
}

# Keycloak: отдельный порт, чтобы не возиться с hostname-подпутями.
# KC_HOSTNAME=https://домен:8444 (compose-override) → iss токенов совпадает
# с APP_KEYCLOAK_URL бэкенда.
server {
    listen 8444 ssl;
    http2 on;
    server_name _;

    ssl_certificate     ${LE_CERT_PATH}/fullchain.pem;
    ssl_certificate_key ${LE_CERT_PATH}/privkey.pem;

    location / {
        proxy_pass http://keycloak:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
}
